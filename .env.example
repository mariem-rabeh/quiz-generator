# Copier ce fichier vers .env et renseigner la clé (jamais commitée).

# --- LLM de chat : n'importe quelle API compatible OpenAI --------------------------
LLM_API_KEY=gsk_remplace_moi
LLM_BASE_URL=https://api.groq.com/openai/v1
# Nom du modèle : vérifie le nom actuel dans la documentation du fournisseur.
LLM_MODEL=openai/gpt-oss-120b

# Autres fournisseurs (remplace LLM_BASE_URL, LLM_API_KEY et LLM_MODEL) :
#   OpenAI : laisser LLM_BASE_URL vide
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   xAI    : https://api.x.ai/v1
# Si le fournisseur refuse le mode JSON, décommente la ligne suivante :
# LLM_JSON_MODE=0

# --- Embeddings --------------------------------------------------------------------
# local  = gratuit, calculé sur ta machine (aucun quota d'API)
# openai = API compatible OpenAI (nécessite un modèle d'embedding chez le fournisseur)
EMBEDDING_PROVIDER=local
# Cours en français/arabe : pip install sentence-transformers puis décommente :
# EMBEDDING_LOCAL_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=nom-du-modele-d-embedding   (uniquement si EMBEDDING_PROVIDER=openai)
